{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "MIT",
  "scripts": {
    "build": "sanity build && node scripts/check-single-sdk.mjs",
    "deploy": "pnpm run build && sanity deploy --no-build",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "sanity exec seed/seed.ts --with-user-token",
    "typegen": "sanity schemas extract --path schema.json && sanity typegen generate"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@calm/tokens": "workspace:*",
    "@portabletext/editor": "^8.2.12",
    "@sanity/icons": "^5.3.0",
    "@sanity/sdk-react": "^3.12.0",
    "@sanity/themer": "^0.10.6",
    "@sanity/vision": "^6.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.22.0",
    "sanity-plugin-writing-room": "workspace:*",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "typescript": "~6.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
