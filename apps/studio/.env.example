# Copy to .env.local and fill in. Find both values at https://www.sanity.io/manage
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Where the Writing Room's Preview opens Posts. Point it at your Reading Site when you deploy
# the Studio (e.g. in .env.production.local, or your CI's environment).
SANITY_STUDIO_READING_SITE_URL=http://localhost:3000

# Optional: the Studio's app ID, printed after your first `sanity deploy`.
SANITY_STUDIO_APP_ID=
