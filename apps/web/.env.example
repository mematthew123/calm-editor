# Copy to .env.local and fill in. Find both values at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: only for a custom domain. On Vercel the production URL is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# A Viewer token from your project's API settings: https://www.sanity.io/manage
# Used only to read drafts while previewing from the Writing Room.
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate on publish.
SANITY_REVALIDATE_SECRET=
